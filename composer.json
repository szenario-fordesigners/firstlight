{
  "name": "szenario/craft-firstlight",
  "description": "Automatic poster images for video assets. firstlight grabs a frame with ffmpeg, and Craft transforms serve it as AVIF or WebP.",
  "type": "craft-plugin",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "craftcms/cms": "^5.3.0"
  },
  "require-dev": {
    "craftcms/ecs": "dev-main",
    "craftcms/phpstan": "dev-main",
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "szenario\\craftfirstlight\\": "src/"
    }
  },
  "support": {
    "email": "support@szenario.design",
    "issues": "https://github.com/szenario-fordesigners/firstlight/issues?state=open",
    "source": "https://github.com/szenario-fordesigners/firstlight",
    "docs": "https://github.com/szenario-fordesigners/firstlight#readme",
    "rss": "https://github.com/szenario-fordesigners/firstlight/releases.atom"
  },
  "extra": {
    "handle": "firstlight",
    "name": "firstlight",
    "developer": "szenario",
    "developerUrl": "https://www.szenario-design.com/",
    "documentationUrl": "https://github.com/szenario-fordesigners/firstlight#readme",
    "changelogUrl": "https://github.com/szenario-fordesigners/firstlight/blob/main/CHANGELOG.md",
    "class": "szenario\\craftfirstlight\\FirstLight"
  },
  "scripts": {
    "check-cs": "ecs check --ansi",
    "fix-cs": "ecs check --ansi --fix",
    "phpstan": "phpstan --memory-limit=1G"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.2"
    },
    "allow-plugins": {
      "yiisoft/yii2-composer": true,
      "craftcms/plugin-installer": true
    }
  }
}
